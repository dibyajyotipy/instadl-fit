---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "InstaDL Fit — Fit Photos to Social Ratios without Cropping",
  description = "Instantly add smart blurred backgrounds or solid colors to fit any photo into Instagram, Reels, TikTok, and YouTube aspect ratios. 100% private, local browser processing.",
} = Astro.props;

// Dynamically generate canonical and social URLs based on current page path
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://instadl.online").href;

const isHome = Astro.url.pathname === "/";

// WebSite and Organization schema for the homepage
const websiteSchema = isHome ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "InstaDL Fit",
  "url": "https://instadl.online",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://instadl.online/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
} : null;

const organizationSchema = isHome ? {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "InstaDL",
  "url": "https://instadl.online",
  "logo": "https://instadl.online/favicon.svg",
  "sameAs": [
    "https://github.com/dibyajyotipy/instadl-fit"
  ]
} : null;

// Dynamic Breadcrumb Schema
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbs = pathSegments.map((segment, index) => {
  const href = new URL('/' + pathSegments.slice(0, index + 1).join('/'), Astro.site || "https://instadl.online").href;
  let label = segment.replace(/-/g, ' ');
  label = label.charAt(0).toUpperCase() + label.slice(1);
  return {
    "@type": "ListItem",
    "position": index + 2,
    "name": label,
    "item": href
  };
});

const breadcrumbSchema = pathSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": new URL('/', Astro.site || "https://instadl.online").href
    },
    ...breadcrumbs
  ]
} : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#09090b" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://instadl.online/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://instadl.online/og-image.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- App is optimized strictly for Light Theme -->

    <!-- JSON-LD SoftwareApplication Schema for Search Engine Utility Cards -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "InstaDL Fit",
      "operatingSystem": "All",
      "applicationCategory": "MultimediaApplication",
      "browserRequirements": "Requires HTML5 canvas support",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Instantly add smart blurred backgrounds or solid borders to fit any photo into Instagram, Reels, TikTok, and YouTube aspect ratios. 100% private, local browser processing."
    }
    </script>

    {websiteSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}

    {organizationSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    )}

    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body class="bg-canvas text-body font-sans relative antialiased selection:bg-ink selection:text-canvas">
    <!-- Header -->
    <header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hairline-strong rounded-md">
          <svg class="h-6 w-6 text-ink transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <circle cx="12" cy="10" r="3" />
            <path d="M21 15h-6l-3-3-3 3H3" />
          </svg>
          <span class="font-mono text-sm tracking-tight text-ink font-semibold flex items-center gap-1.5">
            instadl<span class="text-xs bg-hairline-strong text-ink px-1.5 py-0.5 rounded-sm font-normal">fit</span>
          </span>
        </a>

        <div class="flex items-center gap-2 sm:gap-4 md:gap-6">
          <nav class="hidden md:flex items-center gap-6">
            <a href="/#tools" class="text-sm text-body hover:text-ink transition-colors">Tools</a>
            <a href="/blog" class="text-sm text-body hover:text-ink transition-colors">Blog</a>
            <a href="/#faq" class="text-sm text-body hover:text-ink transition-colors">FAQ</a>
            <a href="https://github.com/dibyajyotipy/instadl-fit" target="_blank" rel="noopener noreferrer" class="text-sm text-body hover:text-ink transition-colors flex items-center gap-1">
              GitHub
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path></svg>
            </a>
          </nav>

          <a
            href="/suggest-a-tool"
            class="relative inline-flex items-center gap-1 px-2.5 py-1.5 sm:gap-1.5 sm:px-4 sm:py-2 text-[11px] sm:text-xs font-semibold text-white rounded-full bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-500 hover:via-purple-500 hover:to-pink-500 transition-all duration-300 shadow-[0_2px_8px_rgba(99,102,241,0.25)] hover:shadow-[0_4px_16px_rgba(236,72,153,0.45)] hover:-translate-y-0.5 active:translate-y-0 active:scale-95 overflow-hidden group whitespace-nowrap"
          >
            <!-- Glowing background transition -->
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 opacity-0 group-hover:opacity-100 transition-opacity duration-500 ease-out"></span>
            
            <!-- Shimmer effect -->
            <span class="absolute top-0 -inset-full h-full w-1/2 z-5 block transform -skew-x-12 bg-gradient-to-r from-transparent via-white/20 to-transparent group-hover:animate-shine"></span>

            <!-- Content -->
            <span class="relative z-10 flex items-center gap-1 sm:gap-1.5">
              <svg class="h-3.5 w-3.5 text-white transition-transform duration-500 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                <path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5z"/>
                <path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1z"/>
              </svg>
              <span>Build Next Tool</span>
            </span>
          </a>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-button"
            type="button"
            class="md:hidden inline-flex items-center justify-center p-1.5 rounded-lg text-body hover:text-ink hover:bg-canvas-soft-2 focus:outline-none focus:ring-2 focus:ring-hairline-strong transition-colors cursor-pointer"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <svg id="hamburger-icon" class="h-5.5 w-5.5 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" x2="20" y1="12" y2="12" />
              <line x1="4" x2="20" y1="6" y2="6" />
              <line x1="4" x2="20" y1="18" y2="18" />
            </svg>
            <svg id="close-icon" class="h-5.5 w-5.5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" x2="6" y1="6" y2="18" />
              <line x1="6" x2="18" y1="6" y2="18" />
            </svg>
          </button>
        </div>

        <!-- App defaults strictly to Light Theme -->
      </div>
    </header>

    <!-- Mobile Menu Drawer -->
    <div
      id="mobile-menu"
      class="hidden md:hidden fixed inset-x-0 top-[64px] z-45 w-full border-b border-hairline bg-canvas/95 backdrop-blur-md transition-all duration-300 ease-in-out origin-top scale-y-95 opacity-0"
    >
      <div class="px-4 pt-2 pb-6 space-y-2.5 shadow-lg">
        <a href="/#tools" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-semibold text-body hover:text-ink hover:bg-canvas-soft-2 transition-all">Tools</a>
        <a href="/blog" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-semibold text-body hover:text-ink hover:bg-canvas-soft-2 transition-all">Blog</a>
        <a href="/#faq" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-semibold text-body hover:text-ink hover:bg-canvas-soft-2 transition-all">FAQ</a>
        <a href="https://github.com/dibyajyotipy/instadl-fit" target="_blank" rel="noopener noreferrer" class="mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg text-sm font-semibold text-body hover:text-ink hover:bg-canvas-soft-2 transition-all">
          <span>GitHub</span>
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path></svg>
        </a>
      </div>
    </div>

    <main class="min-h-[calc(100vh-4rem-12rem)]">
      <slot />
    </main>

    <Footer />

    <script>
      // Service Worker registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      // Mobile Menu Toggle Logic
      const menuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

      if (menuButton && mobileMenu && hamburgerIcon && closeIcon) {
        const toggleMenu = () => {
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            requestAnimationFrame(() => {
              mobileMenu.classList.remove('scale-y-95', 'opacity-0');
              mobileMenu.classList.add('scale-y-100', 'opacity-100');
            });
            hamburgerIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
            menuButton.setAttribute('aria-expanded', 'true');
          } else {
            mobileMenu.classList.remove('scale-y-100', 'opacity-100');
            mobileMenu.classList.add('scale-y-95', 'opacity-0');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            menuButton.setAttribute('aria-expanded', 'false');
            
            setTimeout(() => {
              if (menuButton.getAttribute('aria-expanded') === 'false') {
                mobileMenu.classList.add('hidden');
              }
            }, 300);
          }
        };

        menuButton.addEventListener('click', toggleMenu);

        mobileNavLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (!mobileMenu.classList.contains('hidden')) {
              toggleMenu();
            }
          });
        });
      }
    </script>
  </body>
</html>
