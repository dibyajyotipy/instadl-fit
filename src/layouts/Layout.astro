---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "InstaDL Fit — Fit Photos to Social Ratios without Cropping",
  description = "Instantly add smart blurred backgrounds or solid colors to fit any photo into Instagram, Reels, TikTok, and YouTube aspect ratios. 100% private, local browser processing.",
} = Astro.props;

// Dynamically generate canonical and social URLs based on current page path
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://instadl.online").href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#09090b" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://instadl.online/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://instadl.online/og-image.png" />

    <!-- Preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- App is optimized strictly for Light Theme -->

    <!-- JSON-LD SoftwareApplication Schema for Search Engine Utility Cards -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "InstaDL Fit",
      "operatingSystem": "All",
      "applicationCategory": "MultimediaApplication",
      "browserRequirements": "Requires HTML5 canvas support",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Instantly add smart blurred backgrounds or solid borders to fit any photo into Instagram, Reels, TikTok, and YouTube aspect ratios. 100% private, local browser processing."
    }
    </script>

    <!-- JSON-LD FAQ Schema for Search Rich Snippets -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How can I fit a full picture on Instagram without cropping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can fit a full picture on Instagram without cropping by adding a padded border or blurred background to make the photo conform to Instagram's standard aspect ratios (like 1:1 square or 4:5 portrait) using our free browser-based Instagram No Crop Tool."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best aspect ratio for Instagram portrait photos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best aspect ratio for Instagram portrait posts is 4:5 (1080 x 1350 pixels). This ratio occupies the maximum vertical screen space in the feed, giving your content the highest visibility."
          }
        },
        {
          "@type": "Question",
          "name": "Is my data safe when uploading photos to this tool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, your photos are 100% safe. All image resizing, padding, and blur processing are performed entirely client-side inside your local browser. No images are uploaded to any servers, ensuring absolute privacy."
          }
        },
        {
          "@type": "Question",
          "name": "Does adding blurred margins reduce the quality of my photo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Our tool processes and exports your photos at their native high resolution (e.g. 1080x1080 for square posts or 1080x1920 for stories) using sharp HTML5 canvas rendering, preserving the original quality of your image."
          }
        }
      ]
    }
    </script>
  </head>
  <body class="bg-canvas text-body font-sans relative antialiased selection:bg-ink selection:text-canvas">
    <!-- Header -->
    <header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hairline-strong rounded-md">
          <svg class="h-6 w-6 text-ink transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <circle cx="12" cy="10" r="3" />
            <path d="M21 15h-6l-3-3-3 3H3" />
          </svg>
          <span class="font-mono text-sm tracking-tight text-ink font-semibold flex items-center gap-1.5">
            instadl<span class="text-xs bg-hairline-strong text-ink px-1.5 py-0.5 rounded-sm font-normal">fit</span>
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-6">
          <a href="/blog" class="text-sm text-body hover:text-ink transition-colors">Blog</a>
          <a href="/#features" class="text-sm text-body hover:text-ink transition-colors">Features</a>
          <a href="/#faq" class="text-sm text-body hover:text-ink transition-colors">FAQ</a>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-sm text-body hover:text-ink transition-colors flex items-center gap-1">
            GitHub
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path></svg>
          </a>
        </nav>

        <!-- App defaults strictly to Light Theme -->
      </div>
    </header>

    <main class="min-h-[calc(100vh-4rem-12rem)]">
      <slot />
    </main>

    <Footer />

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
