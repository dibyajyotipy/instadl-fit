      tempCtx.shadowOffsetY = 15;
      
      tempCtx.fillStyle = "rgba(255, 255, 255, 0.12)";
      tempCtx.beginPath();
      tempCtx.roundRect ? tempCtx.roundRect(400, 240, 400, 320, 20) : tempCtx.rect(400, 240, 400, 320);
      tempCtx.fill();
      
      tempCtx.shadowColor = "transparent";
      tempCtx.shadowBlur = 0;
      tempCtx.shadowOffsetY = 0;

      // Add text
      tempCtx.font = "bold 64px Inter, system-ui, sans-serif";
      tempCtx.fillStyle = "#ffffff";
      tempCtx.textAlign = "center";
      tempCtx.textBaseline = "middle";
      tempCtx.fillText("instadl fit", 600, 370);
      
      tempCtx.font = "500 22px JetBrains Mono, monospace";
      tempCtx.fillStyle = "rgba(255, 255, 255, 0.75)";
      tempCtx.fillText("1200 x 800 Demo Landscape", 600, 440);
    }

    const dataUrl = tempCanvas.toDataURL("image/png");
    const img = new Image();
    img.onload = () => {
      loadedImage = img;

      // Auto-detect best aspect ratio (16:9 for widescreen demo)
      const bestRatioId = "youtube-thumbnail-16-9";
      activeRatioId = bestRatioId;
      updateRatioButtonsUI();

      document.dispatchEvent(new CustomEvent("apply-ratio", {
        detail: { ratioId: bestRatioId }
      }));

      document.dispatchEvent(new CustomEvent("image-loaded", {
        detail: { width: 1200, height: 800 }
      }));

      if (filenameInput) filenameInput.value = "instadl_fit_demo";

      // Display layouts
      if (canvasEmptyState) canvasEmptyState.classList.add("hidden");
      
      if (mainCanvas) {
        mainCanvas.classList.remove("hidden");
        mainCanvas.style.opacity = "1";
      }

      if (compareBtn) compareBtn.classList.remove("pointer-events-none", "opacity-50");
      if (compareSplitBtn) compareSplitBtn.classList.remove("pointer-events-none", "opacity-50");
      
      const changePhotoBtn = document.getElementById("change-photo-btn");
      if (changePhotoBtn) changePhotoBtn.classList.remove("hidden");

      const quickExportBtn = document.getElementById("quick-export-btn");
      if (quickExportBtn) quickExportBtn.classList.remove("hidden");

      if (exportBtn) exportBtn.disabled = false;
      if (copyClipboardBtn) copyClipboardBtn.disabled = false;

      showLoading(false);
      triggerRender();
      showToast("Demo image loaded!", "info");

      // Scroll to editor frame
      if (canvasFrame) {
        canvasFrame.scrollIntoView({ behavior: "smooth", block: "center" });
