      const grad = tempCtx.createLinearGradient(0, 0, 1200, 800);
      grad.addColorStop(0, "#007cf0");
      grad.addColorStop(0.4, "#7928ca");
      grad.addColorStop(0.8, "#ff0080");
      grad.addColorStop(1, "#f9cb28");
      
      tempCtx.fillStyle = grad;
