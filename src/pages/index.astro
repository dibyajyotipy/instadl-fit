---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PreviewCanvas from "../components/PreviewCanvas.astro";
import RatioSelector from "../components/RatioSelector.astro";
import BackgroundModeSelector from "../components/BackgroundModeSelector.astro";
import FineTuneControls from "../components/FineTuneControls.astro";
import ExportPanel from "../components/ExportPanel.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import SeoContent from "../components/SeoContent.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Instagram No Crop Tool - Resize Photo for Instagram Without Cropping"
  description="Use our free Instagram No Crop Tool to fit full photos on Instagram without cropping. Easily add white borders or add blur background to images online."
>
  <!-- Core App Section -->
  <section id="tool" class="py-8 md:py-12 bg-canvas relative z-20">
    <div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8">
      
      <!-- Unified Workspace Container -->
      <div class="bg-canvas-soft border border-hairline p-4 sm:p-6 md:p-8 rounded-[24px] shadow-level3 backdrop-blur-sm">
        
        <!-- Workspace Top Bar / Toolbar -->
        <div class="flex items-center justify-between border-b border-hairline pb-4 mb-6">
          <div class="flex items-center gap-3">
            <div class="relative flex h-2 w-2 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </div>
            <div class="min-w-0">
              <div class="text-[10px] font-bold text-ink uppercase tracking-widest font-mono leading-none">Canvas Editor</div>
              <div class="text-[11px] text-mute font-mono leading-none mt-1 truncate" id="current-ratio-label">1:1 Instagram Post</div>
            </div>
          </div>
          
          <div class="flex items-center gap-1.5">
            <!-- Change Photo button (only visible when image is loaded) -->
            <button
              id="change-photo-btn"
              class="hidden inline-flex items-center justify-center gap-1.5 h-8.5 w-8.5 md:w-auto md:px-3 rounded-lg text-xs font-medium text-body hover:text-ink bg-canvas-soft border border-hairline hover:border-hairline-strong transition-all duration-150 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 active:scale-[0.98]"
              aria-label="Upload a different photo"
              title="Upload a different photo"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
              </svg>
              <span class="hidden md:inline">Change Photo</span>
            </button>

            <!-- Keyboard Shortcuts help button (hidden on mobile since there is no keyboard) -->
            <button
              id="shortcuts-help-btn"
              class="hidden sm:inline-flex items-center justify-center h-8.5 w-8.5 rounded-lg text-mute hover:text-ink bg-canvas-soft border border-hairline hover:border-hairline-strong transition-all duration-150 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 active:scale-[0.98]"
              title="Show keyboard shortcuts help"
              aria-label="Keyboard shortcuts guide"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect width="20" height="12" x="2" y="6" rx="2" />
                <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01M10 14h4" />
              </svg>
            </button>


            <!-- Compare Action Button -->
            <button
              id="compare-btn"
              class="inline-flex items-center justify-center gap-1.5 h-8.5 w-8.5 md:w-auto md:px-3 rounded-lg text-xs font-medium text-body hover:text-ink bg-canvas-soft border border-hairline hover:border-hairline-strong transition-all duration-150 cursor-pointer select-none pointer-events-none opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 active:scale-[0.98]"
              aria-label="Hold to view original photo"
              title="Hold to view original photo"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
              </svg>
              <span class="hidden md:inline">Compare</span>
            </button>

            <!-- Split Screen Compare Toggle Button -->
            <button
              id="compare-split-btn"
              class="inline-flex items-center justify-center gap-1.5 h-8.5 w-8.5 md:w-auto md:px-3 rounded-lg text-xs font-medium text-body hover:text-ink bg-canvas-soft border border-hairline hover:border-hairline-strong transition-all duration-150 cursor-pointer select-none pointer-events-none opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 active:scale-[0.98]"
              aria-label="Toggle split-screen comparison slider"
              title="Toggle split-screen comparison slider"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect width="18" height="18" x="3" y="3" rx="2" />
                <line x1="12" y1="3" x2="12" y2="21" />
              </svg>
              <span class="hidden md:inline">Split View</span>
            </button>

            <!-- Quick Export/Download Button (always accessible on mobile without tab switching) -->
            <button
              id="quick-export-btn"
              class="hidden inline-flex items-center justify-center h-8.5 w-8.5 rounded-lg text-white bg-primary hover:opacity-90 transition-all duration-150 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 active:scale-[0.98]"
              title="Quick Export Image"
              aria-label="Quick export image"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Two-Column Layout (Side-by-Side on Desktop, Stacked on Mobile) -->
        <div class="grid grid-cols-1 lg:grid-cols-[64%_36%] gap-6 md:gap-8 items-start">
          
          <!-- Sticky Preview Studio (Left) -->
          <div class="sticky top-[64px] lg:top-24 z-30 flex items-center justify-center bg-canvas-soft border border-hairline/60 rounded-2xl p-3 md:p-8 h-[38vh] min-h-[280px] max-h-[340px] sm:h-[45vh] sm:max-h-[400px] lg:h-auto lg:min-h-[600px] overflow-hidden relative shadow-[inset_0_2px_8px_rgba(9,9,11,0.03)]">
            <!-- Decorative background dots inside the preview workspace -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(0,0,0,0.005)_0%,transparent_80%)] pointer-events-none"></div>
            <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px); background-size: 16px 16px;"></div>
            <PreviewCanvas />
          </div>

          <!-- Controls Panel Container (Right - Integrated directly into workspace card on desktop) -->
          <div class="flex flex-col lg:bg-transparent lg:border-0 lg:shadow-none lg:p-0 bg-canvas border border-hairline p-5 rounded-2xl shadow-level2">
            
            <!-- Segmented Tab Navigation -->
            <div class="flex p-1 gap-1 rounded-xl bg-canvas-soft-2/60 border border-hairline mb-6 overflow-x-auto scrollbar-none" id="tool-tabs" role="tablist">
              <button
                id="tab-ratio"
                role="tab"
                aria-selected="true"
                aria-controls="panel-ratio"
                class="flex-1 py-2 text-xs font-bold rounded-lg cursor-pointer transition-all duration-200 select-none text-center bg-neutral-950 text-white shadow-md focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
              >
                Ratio
              </button>
              <button
                id="tab-bg"
                role="tab"
                aria-selected="false"
                aria-controls="panel-bg"
                class="flex-1 py-2 text-xs font-medium rounded-lg cursor-pointer transition-all duration-200 select-none text-center text-neutral-500 hover:text-neutral-900 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
              >
                Background
              </button>
              <button
                id="tab-adjust"
                role="tab"
                aria-selected="false"
                aria-controls="panel-adjust"
                class="flex-1 py-2 text-xs font-medium rounded-lg cursor-pointer transition-all duration-200 select-none text-center text-neutral-500 hover:text-neutral-900 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
              >
                Adjust
              </button>
              <button
                id="tab-export"
                role="tab"
                aria-selected="false"
                aria-controls="panel-export"
                class="flex-1 py-2 text-xs font-medium rounded-lg cursor-pointer transition-all duration-200 select-none text-center text-neutral-500 hover:text-neutral-900 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
              >
                Export
              </button>
            </div>

            <!-- Tab Content Panels -->
            <div id="tab-panels" class="space-y-4">
              
              <!-- Panel 1: Aspect Ratio -->
              <div id="panel-ratio" role="tabpanel" class="transition-all duration-200">
                <div class="space-y-4">
                  <div class="flex items-center justify-between border-b border-hairline pb-2.5 mb-4">
                    <span class="text-[10px] font-bold text-ink uppercase tracking-widest font-sans">01 • Choose Aspect Ratio</span>
                    <span class="text-xs text-mute font-mono" id="current-ratio-label-summary">1:1 Instagram Post</span>
                  </div>
                  <RatioSelector />
                </div>
              </div>

              <!-- Panel 2: Background Style -->
              <div id="panel-bg" role="tabpanel" class="hidden transition-all duration-200">
                <div class="space-y-4">
                  <div class="flex items-center justify-between border-b border-hairline pb-2.5 mb-4">
                    <span class="text-[10px] font-bold text-ink uppercase tracking-widest font-sans">02 • Background Style</span>
                    <span class="text-xs text-mute font-mono" id="active-mode-label">Smart Blur</span>
                  </div>
                  <BackgroundModeSelector />
                </div>
              </div>

              <!-- Panel 3: Fine Tune & Adjust -->
              <div id="panel-adjust" role="tabpanel" class="hidden transition-all duration-200">
                <div class="space-y-4">
                  <div class="flex items-center justify-between border-b border-hairline pb-2.5 mb-4">
                    <span class="text-[10px] font-bold text-ink uppercase tracking-widest font-sans">03 • Fine Tune & Adjust</span>
                  </div>
                  <FineTuneControls />
                </div>
              </div>

              <!-- Panel 4: Format & Export -->
              <div id="panel-export" role="tabpanel" class="hidden transition-all duration-200">
                <div class="space-y-4">
                  <div class="flex items-center justify-between border-b border-hairline pb-2.5 mb-4">
                    <span class="text-[10px] font-bold text-ink uppercase tracking-widest font-sans">04 • Format & Export</span>
                  </div>
                  <ExportPanel />
                </div>
              </div>

            </div>

          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Hero Section -->
  <Hero />


  <!-- Feature Grid -->
  <FeatureGrid />

  <!-- SEO Content Guide -->
  <SeoContent />

  <!-- FAQ Section -->
  <FaqSection />

  <!-- Footer -->
  <Footer />

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-6 right-6 z-[100] flex flex-col gap-2.5 pointer-events-none"></div>

  <!-- Keyboard Shortcuts Help Modal (Hidden by Default) -->
  <div id="shortcuts-modal" class="fixed inset-0 bg-neutral-950/45 backdrop-blur-sm z-[100] flex items-center justify-center hidden opacity-0 transition-opacity duration-200 pointer-events-auto">
    <div class="bg-canvas-soft border border-hairline p-6 rounded-[20px] shadow-level4 max-w-sm w-full mx-4 transform scale-95 transition-transform duration-200" id="shortcuts-modal-card">
      <div class="flex items-center justify-between border-b border-hairline pb-3 mb-4">
        <h3 class="text-xs font-bold text-ink uppercase tracking-wider font-sans flex items-center gap-2">
          <svg class="h-4 w-4 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect width="20" height="12" x="2" y="6" rx="2" />
            <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01M10 14h4" />
          </svg>
          Keyboard Shortcuts
        </h3>
        <button id="close-shortcuts-btn" class="h-6 w-6 rounded-md hover:bg-canvas-soft-2 flex items-center justify-center text-mute hover:text-ink cursor-pointer focus:outline-none">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
      </div>
      
      <div class="space-y-3">
        <div class="flex items-center justify-between text-xs">
          <span class="text-body font-medium">Hold Comparison</span>
          <kbd class="px-2 py-0.5 bg-canvas-soft-2 border border-hairline rounded font-mono text-[10px] text-ink shadow-sm">Spacebar</kbd>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-body font-medium">Export / Download</span>
          <kbd class="px-2 py-0.5 bg-canvas-soft-2 border border-hairline rounded font-mono text-[10px] text-ink shadow-sm">Ctrl + S</kbd>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-body font-medium">Copy to Clipboard</span>
          <kbd class="px-2 py-0.5 bg-canvas-soft-2 border border-hairline rounded font-mono text-[10px] text-ink shadow-sm">Ctrl + C</kbd>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-body font-medium">Switch Tab Panels</span>
          <div class="flex gap-1">
            <kbd class="px-1.5 py-0.5 bg-canvas-soft-2 border border-hairline rounded font-mono text-[10px] text-ink shadow-sm">1</kbd>
            <span class="text-mute">-</span>
            <kbd class="px-1.5 py-0.5 bg-canvas-soft-2 border border-hairline rounded font-mono text-[10px] text-ink shadow-sm">4</kbd>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getRatioById, RATIOS } from "../lib/aspectRatio";
  import { renderFitCanvas, type RenderOptions, type BackgroundMode } from "../lib/canvasRenderer";
  import { exportCanvasAsFile, type ExportConfig } from "../lib/imageExport";

  // Elements
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const canvasFrame = document.getElementById("canvas-frame");
  const dropzone = canvasFrame;
  const heroUploadBtn = document.getElementById("hero-upload-btn");
  const heroDemoBtn = document.getElementById("hero-demo-btn");
  
  const mainCanvas = document.getElementById("main-canvas") as HTMLCanvasElement;
  const compareCanvas = document.getElementById("compare-canvas") as HTMLCanvasElement;
  const canvasEmptyState = document.getElementById("canvas-empty-state");
  const canvasLoadingState = document.getElementById("canvas-loading-state");
  const currentRatioLabel = document.getElementById("current-ratio-label");
  const compareBtn = document.getElementById("compare-btn");
  const compareSplitBtn = document.getElementById("compare-split-btn");
  const splitCompareOverlay = document.getElementById("split-compare-overlay");
  const splitCompareSlider = document.getElementById("split-compare-slider") as HTMLInputElement;
  const splitDivider = document.getElementById("split-divider");

  const ratioButtons = document.querySelectorAll(".ratio-preset-btn");
  const bgModeButtons = document.querySelectorAll("#bg-mode-segmented button");
  const activeModeLabel = document.getElementById("active-mode-label");
  
  const paddingSlider = document.getElementById("padding-slider") as HTMLInputElement;
  const paddingVal = document.getElementById("padding-val");
  
  const scaleSlider = document.getElementById("scale-slider") as HTMLInputElement;
  const scaleVal = document.getElementById("scale-val");
  
  const blurControlsWrapper = document.getElementById("blur-controls-wrapper");
  const blurRadiusSlider = document.getElementById("blur-radius-slider") as HTMLInputElement;
  const blurRadiusVal = document.getElementById("blur-radius-val");
  const blurOpacitySlider = document.getElementById("blur-opacity-slider") as HTMLInputElement;
  const blurOpacityVal = document.getElementById("blur-opacity-val");

  const shadowToggle = document.getElementById("shadow-toggle") as HTMLInputElement;
  const shadowToggleWrapper = document.getElementById("shadow-toggle-wrapper");

  const gradientPresetsWrapper = document.getElementById("gradient-presets-wrapper");
  const gradientPresetButtons = document.querySelectorAll("#gradient-presets-group button");

  const exportFormatButtons = document.querySelectorAll("#export-format-segmented button");
  const qualitySliderWrapper = document.getElementById("quality-slider-wrapper");
  const qualitySlider = document.getElementById("quality-slider") as HTMLInputElement;
  const qualityVal = document.getElementById("quality-val");
  const filenameInput = document.getElementById("filename-input") as HTMLInputElement;
  const exportBtn = document.getElementById("export-btn") as HTMLButtonElement;
  const exportBtnText = document.getElementById("export-btn-text");
  const copyClipboardBtn = document.getElementById("copy-clipboard-btn") as HTMLButtonElement;

  // Quick Export Presets
  const presetJpgHigh = document.getElementById("preset-jpg-high");
  const presetJpgWeb = document.getElementById("preset-jpg-web");
  const presetPng = document.getElementById("preset-png");

  // Keyboard Shortcuts elements
  const shortcutsHelpBtn = document.getElementById("shortcuts-help-btn");
  const quickExportBtn = document.getElementById("quick-export-btn");
  const shortcutsModal = document.getElementById("shortcuts-modal");
  const shortcutsModalCard = document.getElementById("shortcuts-modal-card");
  const closeShortcutsBtn = document.getElementById("close-shortcuts-btn");

  // Tab elements
  const tabs = document.querySelectorAll("#tool-tabs button");
  const tabPanels = document.querySelectorAll("#tab-panels > div");

  // State Variables
  let loadedImage: HTMLImageElement | null = null;
  let activeRatioId: string = "instagram-post-1-1";
  let activeBgMode: BackgroundMode = "blur";
  let paddingValue: number = 0;
  let scaleValue: number = 1.0;
  let blurRadiusValue: number = 40;
  let blurOpacityValue: number = 0.35;
  let isShadowEnabled: boolean = true;
  let activeGradientColors: string[] = ["#7928ca", "#ff0080"];
  let activeCustomColor: string = "#ffebf0";
  
  let exportFormat: "png" | "jpeg" = "jpeg";
  let exportQuality: number = 0.90;
  let isSplitViewActive = false;

  // Initialize
  function init() {
    setupEventListeners();
    updateControlsState();
  }

  // Set Event Listeners
  function setupEventListeners() {
    // 1. Tab switching logic
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        switchTab(index);
      });
    });

    // 2. File Upload Logic
    if (heroUploadBtn) {
      heroUploadBtn.addEventListener("click", () => {
        if (fileInput) fileInput.click();
      });
    }

    if (fileInput) {
      fileInput.addEventListener("change", handleFileSelect);
    }

    if (dropzone) {
      dropzone.addEventListener("drop", handleFileDrop);
    }

    // 3. Demo Trigger
    if (heroDemoBtn) {
      heroDemoBtn.addEventListener("click", handleLoadDemo);
    }

    // 4. Ratio Selectors
    ratioButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-ratio-id");
        if (id) {
          activeRatioId = id;
          updateRatioButtonsUI();
          triggerRender();
        }
      });
    });

    // 5. Background Modes Selector
    bgModeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-mode") as BackgroundMode;
        if (mode) {
          activeBgMode = mode;
          updateBgModeButtonsUI();
          updateControlsState();
          triggerRender();
        }
      });
    });

    // 6. Margin Adjuster
    if (paddingSlider) {
      paddingSlider.addEventListener("input", () => {
        paddingValue = parseInt(paddingSlider.value);
        if (paddingVal) paddingVal.textContent = `${paddingValue}%`;
        triggerRender();
      });
    }

    // 7. Image Scale
    if (scaleSlider) {
      scaleSlider.addEventListener("input", () => {
        const percent = parseInt(scaleSlider.value);
        scaleValue = percent / 100;
        if (scaleVal) scaleVal.textContent = `${percent}%`;
        triggerRender();
      });
    }

    // 8. Blur Radii Slider
    if (blurRadiusSlider) {
      blurRadiusSlider.addEventListener("input", () => {
        blurRadiusValue = parseInt(blurRadiusSlider.value);
        if (blurRadiusVal) blurRadiusVal.textContent = `${blurRadiusValue}px`;
        triggerRender();
      });
    }

    // 9. Blur Opacity Slider
    if (blurOpacitySlider) {
      blurOpacitySlider.addEventListener("input", () => {
        const percent = parseInt(blurOpacitySlider.value);
        blurOpacityValue = percent / 100;
        if (blurOpacityVal) blurOpacityVal.textContent = `${percent}%`;
        triggerRender();
      });
    }

    // 10. Shadow Toggle
    if (shadowToggle) {
      shadowToggle.addEventListener("change", () => {
        isShadowEnabled = shadowToggle.checked;
        triggerRender();
      });
    }

    // 11. Gradient Preset Selectors
    gradientPresetButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const colorsAttr = btn.getAttribute("data-colors");
        if (colorsAttr) {
          activeGradientColors = colorsAttr.split(",");
          
          gradientPresetButtons.forEach((b) => {
            if (b === btn) {
              b.classList.remove("border-transparent");
              b.classList.add("border-ink", "scale-110", "shadow-level2", "active-gradient-preset");
            } else {
              b.classList.remove("border-ink", "scale-110", "shadow-level2", "active-gradient-preset");
              b.classList.add("border-transparent");
            }
          });

          triggerRender();
        }
      });
    });

    // 12. Export Format segmented switch
    exportFormatButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const format = btn.getAttribute("data-format") as "png" | "jpeg";
        if (format) {
          exportFormat = format;
          updateExportFormatUI();
          updateMetadataPreview();
        }
      });
    });

    // 13. Export Quality Slider
    if (qualitySlider) {
      qualitySlider.addEventListener("input", () => {
        const percent = parseInt(qualitySlider.value);
        exportQuality = percent / 100;
        if (qualityVal) qualityVal.textContent = `${percent}%`;
        updateMetadataPreview();
      });
    }

    // 14. Compare Button Actions (Hold to compare)
    if (compareBtn) {
      // Mouse events
      compareBtn.addEventListener("mousedown", showOriginal);
      compareBtn.addEventListener("mouseup", showFormatted);
      compareBtn.addEventListener("mouseleave", showFormatted);

      // Touch events (for mobile)
      compareBtn.addEventListener("touchstart", (e) => {
        e.preventDefault();
        showOriginal();
      }, { passive: false });
      compareBtn.addEventListener("touchend", showFormatted);
    }

    // Split Screen Compare Events
    if (compareSplitBtn && splitCompareSlider) {
      compareSplitBtn.addEventListener("click", toggleSplitView);
      splitCompareSlider.addEventListener("input", updateSplitViewSlider);
    }

    // 15. Main Export Download Trigger
    if (exportBtn) {
      exportBtn.addEventListener("click", triggerDownload);
    }

    if (quickExportBtn) {
      quickExportBtn.addEventListener("click", triggerDownload);
    }

    // Copy to Clipboard trigger
    if (copyClipboardBtn) {
      copyClipboardBtn.addEventListener("click", triggerCopy);
    }

    // Quick presets click triggers
    if (presetJpgHigh) {
      presetJpgHigh.addEventListener("click", () => applyQuickPreset("jpeg", 0.95));
    }
    if (presetJpgWeb) {
      presetJpgWeb.addEventListener("click", () => applyQuickPreset("jpeg", 0.80));
    }
    if (presetPng) {
      presetPng.addEventListener("click", () => applyQuickPreset("png", 1.0));
    }

    // Shortcuts Modal open/close
    if (shortcutsHelpBtn) {
      shortcutsHelpBtn.addEventListener("click", openShortcutsModal);
    }
    if (closeShortcutsBtn) {
      closeShortcutsBtn.addEventListener("click", closeShortcutsModal);
    }
    if (shortcutsModal) {
      shortcutsModal.addEventListener("click", (e) => {
        if (shortcutsModalCard && !shortcutsModalCard.contains(e.target as Node)) {
          closeShortcutsModal();
        }
      });
    }

    // Keyboard Shortcuts Global Event Listener
    document.addEventListener("keydown", handleKeyboardShortcuts);

    // 16. Custom Color Change Listener
    document.addEventListener("custom-color-changed", (e: any) => {
      activeCustomColor = e.detail.color;
      triggerRender();
    });
  }

  // Switch tabs programmatically
  function switchTab(index: number) {
    const tab = tabs[index];
    if (!tab) return;
    
    const targetPanelId = tab.getAttribute("aria-controls");
    
    // Update active tab styles
    tabs.forEach((t) => {
      if (t === tab) {
        t.setAttribute("aria-selected", "true");
        t.className = "flex-1 py-2 text-xs font-bold rounded-lg cursor-pointer transition-all duration-200 select-none text-center bg-neutral-950 text-white shadow-md focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none";
      } else {
        t.setAttribute("aria-selected", "false");
        t.className = "flex-1 py-2 text-xs font-medium rounded-lg cursor-pointer transition-all duration-200 select-none text-center text-neutral-500 hover:text-neutral-900 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none";
      }
    });

    // Show/hide panels
    tabPanels.forEach((panel) => {
      if (panel.id === targetPanelId) {
        panel.classList.remove("hidden");
        // Micro-animation: fade & slide up
        panel.style.opacity = "0";
        panel.style.transform = "translateY(4px)";
        requestAnimationFrame(() => {
          panel.style.transition = "opacity 0.2s ease, transform 0.2s ease";
          panel.style.opacity = "1";
          panel.style.transform = "translateY(0)";
        });
      } else {
        panel.classList.add("hidden");
        panel.style.opacity = "0";
        panel.style.transform = "translateY(4px)";
      }
    });
  }

  // Handle uploaded files
  function handleFileSelect(event: Event) {
    const target = event.target as HTMLInputElement;
    const file = target.files?.[0];
    if (file) {
      processFile(file);
    }
  }

  function handleFileDrop(event: DragEvent) {
    const file = event.dataTransfer?.files?.[0];
    if (file) {
      processFile(file);
    }
  }


  function processFile(file: File) {
    if (!file.type.startsWith("image/")) {
      showToast("Please upload a valid image file.", "error");
      return;
    }

    // Set loading indicator
    showLoading(true);

    const reader = new FileReader();
    reader.onload = (e) => {
      const dataUrl = e.target?.result as string;
      const img = new Image();
      img.onload = () => {
        loadedImage = img;

        // Auto-detect best aspect ratio matches
        const imgWidth = img.naturalWidth || img.width;
        const imgHeight = img.naturalHeight || img.height;
        const bestRatioId = findClosestRatio(imgWidth, imgHeight);
        activeRatioId = bestRatioId;
        updateRatioButtonsUI();

        document.dispatchEvent(new CustomEvent("apply-ratio", {
          detail: { ratioId: bestRatioId }
        }));

        document.dispatchEvent(new CustomEvent("image-loaded", {
          detail: { width: imgWidth, height: imgHeight }
        }));

        // Auto-fill filename input based on uploaded image name (removing extension)
        const nameWithoutExt = file.name.substring(0, file.name.lastIndexOf(".")) || file.name;
        if (filenameInput) {
          filenameInput.value = `${nameWithoutExt.replace(/\s+/g, "_")}_fit`;
        }

        // Display layouts
        if (canvasEmptyState) canvasEmptyState.classList.add("hidden");
        
        // Premium fade-in animation for canvas
        if (mainCanvas) {
          mainCanvas.classList.remove("hidden");
          mainCanvas.style.opacity = "0";
          mainCanvas.style.transform = "scale(0.98)";
          requestAnimationFrame(() => {
            mainCanvas.style.transition = "opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1)";
            mainCanvas.style.opacity = "1";
            mainCanvas.style.transform = "scale(1)";
          });
        }

        if (compareBtn) compareBtn.classList.remove("pointer-events-none", "opacity-50");
        if (compareSplitBtn) compareSplitBtn.classList.remove("pointer-events-none", "opacity-50");
        
        const changePhotoBtn = document.getElementById("change-photo-btn");
        if (changePhotoBtn) changePhotoBtn.classList.remove("hidden");

        const quickExportBtn = document.getElementById("quick-export-btn");
        if (quickExportBtn) quickExportBtn.classList.remove("hidden");

        if (exportBtn) exportBtn.disabled = false;
        if (copyClipboardBtn) copyClipboardBtn.disabled = false;

        showLoading(false);
        triggerRender();
        showToast("Image loaded successfully!", "success");

        // Scroll to editor frame if upload is from hero
        if (canvasFrame) {
          canvasFrame.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      };
      img.src = dataUrl;
    };
    reader.readAsDataURL(file);
  }

  // Find closest preset aspect ratio
  function findClosestRatio(width: number, height: number): string {
    const imgRatio = width / height;
    let closestId = "instagram-post-1-1";
    let minDiff = Infinity;
    
    for (const preset of RATIOS) {
      const diff = Math.abs(preset.ratio - imgRatio);
      if (diff < minDiff) {
        minDiff = diff;
        closestId = preset.id;
      }
    }
    return closestId;
  }

  // Handle Demo Mode Loader
  function handleLoadDemo() {
    showLoading(true);
    
    const tempCanvas = document.createElement("canvas");
    tempCanvas.width = 1200;
    tempCanvas.height = 800;
    const tempCtx = tempCanvas.getContext("2d");
    
