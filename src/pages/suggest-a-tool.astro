  <!-- Client-side script handling typewriter, mouse spotlights, scroll reveal, and stats count-up -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Typewriter Animation
      const phrases = [
        "Your Idea Could Be Next",
        "Instagram Story Resizer",
        "Reel Cover Maker",
        "Carousel Splitter"
      ];
      let phraseIndex = 0;
      let characterIndex = 0;
      let isDeleting = false;
      const typewriterEl = document.getElementById("typewriter-text");
      const typingSpeed = 90;
      const deletingSpeed = 45;
      const delayBetweenPhrases = 2500;

      function type() {
        if (!typewriterEl) return;
        const currentPhrase = phrases[phraseIndex];
        
        if (isDeleting) {
          typewriterEl.textContent = currentPhrase.substring(0, characterIndex - 1);
          characterIndex--;
        } else {
          typewriterEl.textContent = currentPhrase.substring(0, characterIndex + 1);
          characterIndex++;
        }

        let speed = isDeleting ? deletingSpeed : typingSpeed;

        if (!isDeleting && characterIndex === currentPhrase.length) {
          speed = delayBetweenPhrases;
          isDeleting = true;
        } else if (isDeleting && characterIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          speed = 500; // brief pause before starting new phrase
        }

        setTimeout(type, speed);
      }

      if (prefersReducedMotion) {
        if (typewriterEl) {
          typewriterEl.textContent = phrases[0];
          const cursor = document.getElementById("typewriter-cursor");
          if (cursor) cursor.style.display = 'none';
        }
      } else {
        setTimeout(type, 800);
      }

      // 2. Mouse Follow Spotlight Glow Effect
      const heroSection = document.getElementById("hero-section");
      const spotlight = document.getElementById("spotlight-glow");

      if (heroSection && spotlight && !prefersReducedMotion) {
        let activeFrame = null;
        
        heroSection.addEventListener("mousemove", (e) => {
          if (activeFrame) {
            cancelAnimationFrame(activeFrame);
          }
          
          activeFrame = requestAnimationFrame(() => {
            const rect = heroSection.getBoundingClientRect();
            const x = e.clientX - rect.left - 250; // center the 500px circle
            const y = e.clientY - rect.top - 250;
            spotlight.style.transform = `translate3d(${x}px, ${y}px, 0)`;
            spotlight.style.opacity = "1";
          });
        });
        
        heroSection.addEventListener("mouseleave", () => {
          if (activeFrame) {
            cancelAnimationFrame(activeFrame);
          }
          spotlight.style.opacity = "0";
        });
      }

      // 3. Staggered Scroll Reveal for Roadmap Cards
      const roadmapCards = document.querySelectorAll(".roadmap-card");
      if (roadmapCards.length > 0) {
        if (prefersReducedMotion) {
          roadmapCards.forEach(card => card.classList.add("reveal"));
        } else {
          const observerOptions = {
            root: null,
            rootMargin: "0px 0px -80px 0px",
            threshold: 0.1
          };

          const observer = new IntersectionObserver((entries, observer) => {
            const intersecting = entries.filter(entry => entry.isIntersecting);
            intersecting.forEach((entry, index) => {
              const card = entry.target;
              setTimeout(() => {
                card.classList.add("reveal");
              }, index * 120); // 120ms staggered delay
              observer.unobserve(card);
            });
          }, observerOptions);

          roadmapCards.forEach(card => {
            observer.observe(card);
          });
        }
      }

      // 4. Live Stats Count Up
      const stats = document.querySelectorAll("[data-target]");
      if (stats.length > 0) {
        const runCountUp = () => {
          stats.forEach(stat => {
            const target = +stat.getAttribute("data-target");
            const duration = 1200; // 1.2s count up animation
            const stepTime = 16;
            const steps = duration / stepTime;
            const stepValue = target / steps;
            let current = 0;

            const update = () => {
              current += stepValue;
              if (current >= target) {
                stat.textContent = target;
              } else {
                stat.textContent = Math.floor(current);
                requestAnimationFrame(update);
              }
            };
            
            if (prefersReducedMotion) {
              stat.textContent = target;
            } else {
              update();
            }
          });
        };

        // Trigger count-up when visible
        const statsContainer = stats[0].parentElement.parentElement;
        if (statsContainer) {
          const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
              runCountUp();
              observer.disconnect();
            }
          }, { threshold: 0.1 });
          observer.observe(statsContainer);
        } else {
          runCountUp();
        }
      }

      // 5. Submit Transition Overlay Handler
      const overlay = document.getElementById("submit-transition-overlay");
      const progressBar = document.getElementById("transition-progress");
      const submitTriggers = document.querySelectorAll(".submit-idea-trigger");

      submitTriggers.forEach(trigger => {
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          const targetUrl = trigger.getAttribute("href");

          if (overlay && progressBar) {
            // Show overlay
            overlay.classList.remove("pointer-events-none");
            overlay.classList.add("opacity-100");
            const card = overlay.querySelector(".transform");
            if (card) {
              card.classList.remove("scale-90");
              card.classList.add("scale-100");
            }

            // Animate progress bar
            setTimeout(() => {
              progressBar.style.width = "100%";
            }, 50);

            // Open URL and reset after 900ms
            setTimeout(() => {
              window.open(targetUrl, "_blank", "noopener,noreferrer");
              
              // Fade overlay out slowly so they return to a clean page
              setTimeout(() => {
                overlay.classList.add("pointer-events-none");
                overlay.classList.remove("opacity-100");
                if (card) {
                  card.classList.remove("scale-100");
                  card.classList.add("scale-90");
                }
                progressBar.style.width = "0%";
              }, 400);
            }, 900);
          } else {
            window.open(targetUrl, "_blank", "noopener,noreferrer");
          }
        });
      });
    });
  </script>
