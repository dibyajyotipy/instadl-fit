---
import Layout from "../layouts/Layout.astro";

const title = "Terms of Service — InstaDL Fit";
const description = "Review the terms of service for using InstaDL Fit. Learn about service availability, intellectual property policies, and liability limitations.";
const lastUpdated = "June 12, 2026";
---

<Layout title={title} description={description}>
  <div class="border-t border-hairline py-16 md:py-24 bg-canvas min-h-screen">
    <div class="mx-auto max-w-3xl px-6">
      <!-- Page Header -->
      <header class="mb-12 border-b border-hairline pb-8">
        <p class="text-[10px] font-mono font-bold tracking-widest text-mute uppercase mb-2">Legal Info</p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink mb-4">Terms of Service</h1>
        <p class="text-xs text-mute font-mono">Last Updated: {lastUpdated}</p>
      </header>

      <!-- Terms Content -->
      <div class="space-y-8 text-sm sm:text-base leading-relaxed text-body">
        <section class="space-y-3">
          <h2 class="text-base font-bold text-ink font-mono uppercase tracking-wide">1. Acceptance of Terms</h2>
          <p>
            By accessing and using the InstaDL Fit website (located at instadl.online), you agree to comply with and be bound by these Terms of Service. If you do not agree to these terms, please do not use our services.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-base font-bold text-ink font-mono uppercase tracking-wide">2. Scope of Service & Free Usage</h2>
          <p>
            InstaDL Fit provides browser-based image aspect ratio and padding utilities. The service is provided 100% free of charge for personal and commercial creative work. No account signup, registration, or subscription is required.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-base font-bold text-ink font-mono uppercase tracking-wide">3. Service Availability & Support</h2>
          <p>
            This web utility is provided on an "as is" and "as available" basis without warranties of any kind. We do not guarantee continuous uptime, error-free operations, or dedicated customer support. We reserve the right to modify, suspend, or discontinue any portion of the site at our discretion without prior notice.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-base font-bold text-ink font-mono uppercase tracking-wide">4. Content Ownership & Intellectual Property</h2>
          <p>
            We claim zero ownership rights over the photos you import or export using our tools. Because all image processing occurs locally on your machine, your files are never transmitted to us. You retain all copyright and intellectual property rights associated with your visual media.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-base font-bold text-ink font-mono uppercase tracking-wide">5. User Responsibility</h2>
          <p>
            You are solely responsible for the content you choose to resize and publish. You agree not to use our tool to format or distribute content that violates intellectual property laws, local regulations, or terms of service of third-party platforms.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-base font-bold text-ink font-mono uppercase tracking-wide">6. Limitation of Liability</h2>
          <p>
            In no event shall InstaDL Fit, its developers, or its affiliates be liable for any direct, indirect, incidental, special, or consequential damages (including, but not limited to, loss of data, image corruption, or business interruption) arising out of the use or inability to use this website.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-base font-bold text-ink font-mono uppercase tracking-wide">7. Changes to Terms</h2>
          <p>
            We reserve the right to revise these terms at any time. Any revisions will be marked by updating the "Last Updated" date at the top of this page. Your continued use of the website following changes indicates your acceptance of the updated terms.
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>
