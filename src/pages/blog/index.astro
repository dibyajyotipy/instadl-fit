---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Blog | InstaDL" description="Articles and guides on optimizing and resizing photos for social media.">
  <div class="py-16 md:py-24 bg-canvas border-t border-hairline min-h-[60vh]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <header class="mb-12 border-b border-hairline pb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas-soft-2 text-[10px] font-mono text-ink mb-4 select-none">
          <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Latest Creator Guides
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-ink font-sans">
          Blog
        </h1>
        <p class="text-mute mt-2 text-sm sm:text-base max-w-xl">
          Level up your social media presence with our expert guides on image optimization, resolution standards, and formatting.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <article class="blog-card group">
            <div class="card-inner">
              <div class="card-body">
                <span class="card-date">
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
                <h2 class="card-title">
                  <a href={`/blog/${post.slug}`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="card-description">
                  {post.data.description}
                </p>
              </div>
              <div class="card-footer">
                <a href={`/blog/${post.slug}`} class="card-link">
                  Read Article
                  <svg class="link-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .blog-card {
    height: 100%;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    background-color: var(--canvas-soft);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    box-shadow: var(--shadow-level1);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-inner:hover {
    border-color: var(--hairline-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-level3);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-date {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: var(--link);
  }

  .card-description {
    font-size: 0.8125rem;
    color: var(--body);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-link:hover {
    color: var(--link);
  }

  .link-arrow {
    width: 0.75rem;
    height: 0.75rem;
    stroke: currentColor;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-link:hover .link-arrow {
    transform: translateX(3px);
  }
</style>
