---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found | InstaDL"
  description="Oops! The page you are looking for does not exist. Return to the homepage to resize your photos without cropping."
>
  <section class="min-h-[75vh] flex items-center justify-center bg-canvas relative overflow-hidden py-16">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(var(--grid-dot)_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 pointer-events-none opacity-20 z-0">
      <div class="w-[450px] h-[450px] rounded-full blur-[120px] bg-gradient-to-tr from-violet-500/30 to-indigo-500/30"></div>
    </div>

    <div class="mx-auto max-w-xl px-6 text-center relative z-10">
      <!-- Icon/Tag -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas-soft text-[10px] font-mono text-mute mb-6 select-none">
        <span class="flex h-1.5 w-1.5 rounded-full bg-rose-500"></span>
        Error 404
      </div>

      <!-- Main Heading -->
      <h1 class="text-6xl md:text-8xl font-black tracking-tight text-ink font-mono mb-4">
        404
      </h1>
      <h2 class="text-2xl font-bold tracking-tight text-ink mb-3">
        Page Not Found
      </h2>
      <p class="text-sm md:text-base text-body leading-relaxed max-w-md mx-auto mb-10">
        We couldn't find the page you're looking for. It might have been moved, deleted, or the URL might be typed incorrectly.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs font-bold bg-neutral-950 text-white hover:bg-neutral-900 transition-colors shadow-md focus:outline-none focus:ring-2 focus:ring-neutral-950/20 active:scale-[0.98]">
          Go to Home Editor
        </a>
        <a href="/blog" class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs font-semibold bg-canvas-soft text-ink border border-hairline hover:border-hairline-strong transition-colors focus:outline-none focus:ring-2 focus:ring-neutral-950/10 active:scale-[0.98]">
          Browse Blog Articles
        </a>
      </div>

      <!-- Quick Links Section -->
      <div class="border-t border-hairline pt-8 text-left">
        <h3 class="font-mono text-[10px] font-bold text-ink uppercase tracking-wider mb-4 text-center sm:text-left">
          Looking for a specific resizing utility?
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <a href="/fit-full-photo-instagram" class="flex items-center justify-between p-3 rounded-lg border border-hairline bg-canvas-soft/40 hover:border-hairline-strong/60 hover:bg-canvas-soft transition-all group">
            <span class="text-body group-hover:text-ink font-medium">Fit Full Photo on Instagram</span>
            <svg class="h-3 w-3 text-mute group-hover:text-ink transition-transform group-hover:translateX-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="/convert-landscape-to-portrait" class="flex items-center justify-between p-3 rounded-lg border border-hairline bg-canvas-soft/40 hover:border-hairline-strong/60 hover:bg-canvas-soft transition-all group">
            <span class="text-body group-hover:text-ink font-medium">Convert Landscape to Portrait</span>
            <svg class="h-3 w-3 text-mute group-hover:text-ink transition-transform group-hover:translateX-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="/no-crop-square-blur" class="flex items-center justify-between p-3 rounded-lg border border-hairline bg-canvas-soft/40 hover:border-hairline-strong/60 hover:bg-canvas-soft transition-all group">
            <span class="text-body group-hover:text-ink font-medium">No Crop Square Blur</span>
            <svg class="h-3 w-3 text-mute group-hover:text-ink transition-transform group-hover:translateX-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="/instagram-3-4-grid-fix" class="flex items-center justify-between p-3 rounded-lg border border-hairline bg-canvas-soft/40 hover:border-hairline-strong/60 hover:bg-canvas-soft transition-all group">
            <span class="text-body group-hover:text-ink font-medium">Fix Profile Grid Crop</span>
            <svg class="h-3 w-3 text-mute group-hover:text-ink transition-transform group-hover:translateX-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
