---
---
<div class="space-y-4">
  <!-- Padding / Margin Adjuster (available in all modes) -->
  <div class="space-y-2">
    <div class="flex items-center justify-between text-xs">
      <label for="padding-slider" class="text-body font-medium cursor-pointer font-sans">Inner Margin (Padding)</label>
      <span id="padding-val" class="font-mono text-ink font-semibold tabular-nums">0%</span>
    </div>
    <input
      type="range"
      id="padding-slider"
      min="0"
      max="30"
      value="0"
      class="w-full h-1 bg-hairline rounded-lg appearance-none cursor-pointer accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
    />
  </div>

  <!-- Image Scale (available in all modes) -->
  <div class="space-y-2">
    <div class="flex items-center justify-between text-xs">
      <label for="scale-slider" class="text-body font-medium cursor-pointer font-sans">Image Scaling</label>
      <span id="scale-val" class="font-mono text-ink font-semibold tabular-nums">100%</span>
    </div>
    <input
      type="range"
      id="scale-slider"
      min="30"
      max="150"
      value="100"
      class="w-full h-1 bg-hairline rounded-lg appearance-none cursor-pointer accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
    />
  </div>

  <!-- Blur Controls (only visible when mode is 'blur') -->
  <div id="blur-controls-wrapper" class="space-y-4 transition-all duration-200">
    <!-- Blur Radius Slider -->
    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs">
        <label for="blur-radius-slider" class="text-body font-medium cursor-pointer font-sans">Blur Intensity</label>
        <span id="blur-radius-val" class="font-mono text-ink font-semibold tabular-nums font-sans">40px</span>
      </div>
      <input
        type="range"
        id="blur-radius-slider"
        min="10"
        max="100"
        value="40"
        class="w-full h-1 bg-hairline rounded-lg appearance-none cursor-pointer accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
      />
    </div>

    <!-- Brightness / Darken Slider -->
    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs">
        <label for="blur-opacity-slider" class="text-body font-medium cursor-pointer font-sans">Overlay Darkening</label>
        <span id="blur-opacity-val" class="font-mono text-ink font-semibold tabular-nums font-sans">35%</span>
      </div>
      <input
        type="range"
        id="blur-opacity-slider"
        min="0"
        max="90"
        value="35"
        class="w-full h-1 bg-hairline rounded-lg appearance-none cursor-pointer accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
      />
    </div>
  </div>

  <!-- Drop Shadow Toggle (disabled in black mode) -->
  <div class="flex items-center justify-between text-xs border-t border-hairline pt-4" id="shadow-toggle-wrapper">
    <label for="shadow-toggle" class="text-body font-medium cursor-pointer font-sans">Floating Drop Shadow</label>
    <label class="relative inline-flex items-center cursor-pointer select-none">
      <input type="checkbox" id="shadow-toggle" class="sr-only peer" checked />
      <div class="w-9 h-5 bg-hairline-strong peer-focus-visible:outline-none peer-focus-visible:ring-2 peer-focus-visible:ring-primary rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-canvas after:border-neutral-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary peer-checked:after:bg-on-primary peer-checked:after:border-on-primary"></div>
    </label>
  </div>
</div>
