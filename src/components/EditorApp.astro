  function getActiveRenderOptions(): RenderOptions {
    return {
      backgroundMode: activeBgMode,
      padding: paddingValue,
      blurRadius: blurRadiusValue,
      blurBrightness: activeBgMode === "blur" ? 0.70 : 1,
      blurOpacity: blurOpacityValue,
      shadowEnabled: isShadowEnabled,
      shadowBlur: 30,
      shadowColor: "rgba(0, 0, 0, 0.45)",
      imageScale: scaleValue,
      gradientColors: activeGradientColors,
      customColor: activeCustomColor,
      rotation: rotationValue,
      flipH: isFlippedH,
      flipV: isFlippedV,
      alignX: activeAlignX,
      alignY: activeAlignY,
    };
  }

  function triggerRender() {
    if (!loadedImage || !mainCanvas) return;

    const ratio = getRatioById(activeRatioId);

    if (canvasFrame && canvasFrame.parentElement) {
      canvasFrame.style.width = "";
      canvasFrame.style.height = "";
      canvasFrame.style.aspectRatio = "";

      const parent = canvasFrame.parentElement;
      const parentRect = parent.getBoundingClientRect();
      const parentW = parentRect.width;
      const parentH = parentRect.height;

      const targetRatio = ratio.width / ratio.height;
      const parentRatio = parentW / parentH;

      if (parentW > 0 && parentH > 0) {
        let frameW = parentW;
        let frameH = parentH;

        if (targetRatio > parentRatio) {
          frameW = parentW;
          frameH = parentW / targetRatio;
        } else {
          frameH = parentH;
          frameW = parentH * targetRatio;
        }

        canvasFrame.style.width = `${Math.floor(frameW - 2)}px`;
        canvasFrame.style.height = `${Math.floor(frameH - 2)}px`;
        canvasFrame.style.aspectRatio = `${ratio.width} / ${ratio.height}`;
      }
    }

    if (currentRatioLabel) {
      currentRatioLabel.textContent = `${ratio.id.replace(/-/g, " ")} (${ratio.ratioText})`;
    }
    const currentRatioLabelSummary = document.getElementById("current-ratio-label-summary");
    if (currentRatioLabelSummary) {
      currentRatioLabelSummary.textContent = `${ratio.name} (${ratio.ratioText})`;
    }

    const options = getActiveRenderOptions();
    const maxPreviewDim = 1080;
    renderFitCanvas(mainCanvas, loadedImage, ratio, options, maxPreviewDim);

    const compareCanvas = document.getElementById("compare-canvas") as HTMLCanvasElement;
    if (compareCanvas) {
      const originalOptions: RenderOptions = {
        backgroundMode: "black",
        padding: 0,
        blurRadius: 0,
        blurBrightness: 1.0,
        blurOpacity: 0,
        shadowEnabled: false,
        shadowBlur: 0,
        shadowColor: "transparent",
        imageScale: 1.0,
      };
      renderFitCanvas(compareCanvas, loadedImage, ratio, originalOptions, maxPreviewDim);
    }

    if (exportBtnText) {
      exportBtnText.textContent = `Export Image (${ratio.width}x${ratio.height})`;
    }

    updateMetadataPreview();

    if (isSplitViewActive) {
      updateSplitViewSlider();
    }
  }

  function updateMetadataPreview() {
    const ratio = getRatioById(activeRatioId);
    const metaDims = document.getElementById("meta-dimensions");
    const metaSize = document.getElementById("meta-file-size");
    const metaFormat = document.getElementById("meta-format");

    if (metaDims) {
      metaDims.textContent = `${ratio.width} × ${ratio.height} px`;
    }
    if (metaFormat) {
      metaFormat.textContent = exportFormat === "jpeg" 
        ? `JPEG (${Math.round(exportQuality * 100)}%)` 
        : "PNG (Lossless)";
    }
    if (metaSize) {
      metaSize.textContent = estimateFileSize(ratio.width, ratio.height, exportFormat, exportQuality);
    }
  }

  function estimateFileSize(width: number, height: number, format: "png" | "jpeg", quality: number): string {
    let bytes = 0;
    if (format === "png") {
      bytes = (width * height * 1.8) / 8;
    } else {
      const bpp = 0.15 + 2.35 * Math.pow(quality, 2);
      bytes = (width * height * bpp) / 8;
    }

    if (bytes < 1024) return `${Math.round(bytes)} B`;
    if (bytes < 1024 * 1024) return `~${Math.round(bytes / 1024)} KB`;
    return `~${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function showOriginal() {
    if (loadedImage && !isSplitViewActive && mainCanvas) {
      const compCanvas = document.getElementById("compare-canvas") as HTMLCanvasElement;
      if (compCanvas) {
        compCanvas.classList.remove("opacity-0");
        compCanvas.classList.add("opacity-100");
      }
      mainCanvas.classList.add("opacity-0");
    }
  }

  function showFormatted() {
    if (loadedImage && !isSplitViewActive && mainCanvas) {
      const compCanvas = document.getElementById("compare-canvas") as HTMLCanvasElement;
      if (compCanvas) {
        compCanvas.classList.remove("opacity-100");
        compCanvas.classList.add("opacity-0");
      }
      mainCanvas.classList.remove("opacity-0");
    }
  }

  function toggleSplitView() {
    if (!loadedImage) return;

    isSplitViewActive = !isSplitViewActive;

    const compCanvas = document.getElementById("compare-canvas") as HTMLCanvasElement;

    if (isSplitViewActive) {
      compareSplitBtn?.classList.remove("bg-canvas-soft", "text-body");
      compareSplitBtn?.classList.add("bg-neutral-900", "text-white", "border-neutral-900");
      
      splitCompareOverlay?.classList.remove("hidden");
      compCanvas?.classList.remove("opacity-0");
      compCanvas?.classList.add("opacity-100");

      compareBtn?.classList.add("opacity-30", "pointer-events-none");

      updateSplitViewSlider();
      showToast("Split View active! Drag slider to compare.", "info");
    } else {
      compareSplitBtn?.classList.add("bg-canvas-soft", "text-body");
      compareSplitBtn?.classList.remove("bg-neutral-900", "text-white", "border-neutral-900");

      splitCompareOverlay?.classList.add("hidden");
      compCanvas?.classList.remove("opacity-100");
      compCanvas?.classList.add("opacity-0");
      if (compCanvas) compCanvas.style.clipPath = "";

      compareBtn?.classList.remove("opacity-30", "pointer-events-none");
    }
  }

  function updateSplitViewSlider() {
    if (!isSplitViewActive || !splitCompareSlider || !splitDivider || !compareCanvas) return;
    const val = parseInt(splitCompareSlider.value);
    
    splitDivider.style.left = `${val}%`;
    compareCanvas.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
  }

  function openShortcutsModal() {
    if (!shortcutsModal) return;
    shortcutsModal.classList.remove("hidden");
    requestAnimationFrame(() => {
      shortcutsModal.classList.remove("opacity-0");
      shortcutsModal.querySelector("#shortcuts-modal-card")?.classList.remove("scale-95");
      shortcutsModal.querySelector("#shortcuts-modal-card")?.classList.add("scale-100");
    });
  }

  function closeShortcutsModal() {
    if (!shortcutsModal) return;
    shortcutsModal.classList.add("opacity-0");
    shortcutsModal.querySelector("#shortcuts-modal-card")?.classList.remove("scale-100");
    shortcutsModal.querySelector("#shortcuts-modal-card")?.classList.add("scale-95");
    setTimeout(() => {
      shortcutsModal.classList.add("hidden");
    }, 200);
  }

  function handleKeyboardShortcuts(e: KeyboardEvent) {
    const active = document.activeElement;
    if (active && (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.hasAttribute("contenteditable"))) {
      return;
    }

    if (e.key === "1") switchTab(0);
    if (e.key === "2") switchTab(1);
    if (e.key === "3") switchTab(2);
    if (e.key === "4") switchTab(3);

    if ((e.ctrlKey || e.metaKey) && e.key === "s") {
      e.preventDefault();
      if (loadedImage) triggerDownload();
    }

    if ((e.ctrlKey || e.metaKey) && e.key === "c") {
      e.preventDefault();
      if (loadedImage) triggerCopy();
    }

    if (e.key === " " && loadedImage && !isSplitViewActive) {
      e.preventDefault();
      showOriginal();
      
      const releaseCompare = (releaseEvt: KeyboardEvent) => {
        if (releaseEvt.key === " ") {
          showFormatted();
          document.removeEventListener("keyup", releaseCompare);
        }
      };
      document.addEventListener("keyup", releaseCompare);
    }
  }

  function applyQuickPreset(format: "png" | "jpeg", quality: number) {
    if (!loadedImage) return;

    exportFormat = format;
    exportQuality = quality;

    exportFormatButtons.forEach(btn => {
      const btnFormat = btn.getAttribute("data-format");
      if (btnFormat === format) {
        btn.className = "flex-1 text-center py-1.5 px-3 text-xs font-bold rounded-md cursor-pointer transition-all select-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none bg-neutral-950 text-white shadow-md";
      } else {
        btn.className = "flex-1 text-center py-1.5 px-3 text-xs font-medium rounded-md cursor-pointer text-neutral-500 hover:text-neutral-900 transition-all select-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none";
      }
    });

    if (qualitySlider) {
      qualitySlider.value = Math.round(quality * 100).toString();
      if (qualityVal) qualityVal.textContent = `${Math.round(quality * 100)}%`;
    }

    updateExportFormatUI();
    updateMetadataPreview();

    triggerDownload();
  }

  function showToast(message: string, type: "success" | "info" | "error" = "success") {
    const container = document.getElementById("toast-container");
    if (!container) return;

    const toast = document.createElement("div");
    toast.className = "flex items-center gap-3 px-4 py-3 rounded-xl border shadow-level3 bg-canvas-soft border-hairline translate-y-4 opacity-0 transition-all duration-300 pointer-events-auto max-w-sm";
    
    let icon = "";
    if (type === "success") {
      icon = `<svg class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>`;
    } else if (type === "info") {
      icon = `<svg class="h-4 w-4 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
    } else if (type === "error") {
      icon = `<svg class="h-4 w-4 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>`;
    }

    toast.innerHTML = `
      ${icon}
      <div class="text-[11px] font-semibold text-ink leading-tight">${message}</div>
    `;

    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.remove("translate-y-4", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");
    });

    setTimeout(() => {
      toast.classList.remove("translate-y-0", "opacity-100");
      toast.classList.add("translate-y-2", "opacity-0");
      setTimeout(() => {
        toast.remove();
      }, 300);
    }, 3500);
  }

  async function copyCanvasToClipboard(canvas: HTMLCanvasElement): Promise<boolean> {
    try {
      return new Promise((resolve) => {
        canvas.toBlob(async (blob) => {
          if (!blob) {
            resolve(false);
            return;
          }
          try {
            const item = new ClipboardItem({ [blob.type]: blob });
            await navigator.clipboard.write([item]);
            resolve(true);
          } catch (err) {
            console.error("Clipboard write block failed: ", err);
            resolve(false);
          }
        }, "image/png");
      });
    } catch (err) {
      console.error("Clipboard API exception: ", err);
      return false;
    }
  }

  async function triggerCopy() {
    if (!loadedImage || !copyClipboardBtn) return;

    showLoading(true);

    const btnText = copyClipboardBtn.querySelector("span");
    copyClipboardBtn.disabled = true;

    setTimeout(async () => {
      const ratio = getRatioById(activeRatioId);
      const options = getActiveRenderOptions();

      const offscreenCanvas = document.createElement("canvas");
      renderFitCanvas(offscreenCanvas, loadedImage, ratio, options);

      const success = await copyCanvasToClipboard(offscreenCanvas);

      showLoading(false);
      copyClipboardBtn.disabled = false;

      if (success) {
        showToast("Image copied to clipboard!", "success");
      } else {
        showToast("Clipboard copy failed. Try exporting as a file instead.", "error");
      }
    }, 50);
  }

  async function triggerDownload() {
    if (!loadedImage || !mainCanvas) return;

    showLoading(true);

    const format = exportFormat;
    const quality = exportQuality;
    const filename = filenameInput.value || "instadl_fit";

    setTimeout(async () => {
      const ratio = getRatioById(activeRatioId);
      const options = getActiveRenderOptions();

      const exportCanvas = document.createElement("canvas");
      renderFitCanvas(exportCanvas, loadedImage, ratio, options);

      const success = await exportCanvasAsFile(exportCanvas, {
        format,
        quality,
        filename,
      });

      showLoading(false);

      if (success) {
        showToast(`Image downloaded successfully!`, "success");
        document.dispatchEvent(new CustomEvent('download-success'));
      } else {
        showToast("Failed to export image.", "error");
      }
    }, 100);
  }

  function updateControlsState() {
    if (blurControlsWrapper) {
      if (activeBgMode === "blur") {
        blurControlsWrapper.classList.remove("hidden");
      } else {
        blurControlsWrapper.classList.add("hidden");
      }
    }

    if (shadowToggleWrapper) {
      if (activeBgMode === "black") {
        shadowToggleWrapper.classList.add("opacity-40", "pointer-events-none");
      } else {
        shadowToggleWrapper.classList.remove("opacity-40", "pointer-events-none");
      }
    }

    if (gradientPresetsWrapper) {
      if (activeBgMode === "gradient") {
        gradientPresetsWrapper.classList.remove("hidden");
        requestAnimationFrame(() => {
          gradientPresetsWrapper.classList.remove("opacity-0", "translate-y-1");
          gradientPresetsWrapper.classList.add("opacity-100", "translate-y-0");
        });
      } else {
        gradientPresetsWrapper.classList.add("hidden", "opacity-0", "translate-y-1");
        gradientPresetsWrapper.classList.remove("opacity-100", "translate-y-0");
      }
    }

    const customColorWrapper = document.getElementById("custom-color-wrapper");
    if (customColorWrapper) {
      if (activeBgMode === "custom") {
        customColorWrapper.classList.remove("hidden");
        requestAnimationFrame(() => {
          customColorWrapper.classList.remove("opacity-0", "translate-y-1");
          customColorWrapper.classList.add("opacity-100", "translate-y-0");
        });
      } else {
        customColorWrapper.classList.add("hidden", "opacity-0", "translate-y-1");
        customColorWrapper.classList.remove("opacity-100", "translate-y-0");
      }
    }
  }

  function updateTransformButtonsUI() {
