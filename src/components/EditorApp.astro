        flipVBtn.classList.remove("bg-canvas-soft-2/50", "text-body");
        flipVBtn.classList.add("bg-neutral-950", "text-white", "border-neutral-950");
      } else {
        flipVBtn.classList.add("bg-canvas-soft-2/50", "text-body");
        flipVBtn.classList.remove("bg-neutral-950", "text-white", "border-neutral-950");
      }
