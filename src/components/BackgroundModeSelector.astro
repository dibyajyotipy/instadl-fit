</div>

<script>
  // Elements
  const colorPickerInput = document.getElementById("color-picker-input") as HTMLInputElement;
  const colorHexInput = document.getElementById("color-hex-input") as HTMLInputElement;
  const colorRgbInput = document.getElementById("color-rgb-input") as HTMLInputElement;
  const colorHslInput = document.getElementById("color-hsl-input") as HTMLInputElement;
  const customColorVal = document.getElementById("custom-color-val");
  const presetsGroup = document.getElementById("custom-presets-group");
  const recentWrapper = document.getElementById("recent-colors-wrapper");
  const recentGroup = document.getElementById("recent-colors-group");

  // State
  let activeColor = "#ffebf0";
  let recents: string[] = [];

  // Color Converter Utilities
  function hexToRgb(hex: string): { r: number, g: number, b: number } | null {
    const shorthandRegex = /^#?([a-f\d])([a-f\d])([a-f\d])$/i;
    const fullHex = hex.replace(shorthandRegex, (_, r, g, b) => r + r + g + g + b + b);
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(fullHex);
    return result ? {
      r: parseInt(result[1], 16),
      g: parseInt(result[2], 16),
      b: parseInt(result[3], 16)
    } : null;
  }

  function rgbToHex(r: number, g: number, b: number): string {
    const toHex = (c: number) => {
      const h = c.toString(16);
      return h.length === 1 ? "0" + h : h;
    };
    return "#" + toHex(r) + toHex(g) + toHex(b);
  }

  function rgbToHsl(r: number, g: number, b: number): { h: number, s: number, l: number } {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;

    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return {
      h: Math.round(h * 360),
      s: Math.round(s * 100),
      l: Math.round(l * 100)
    };
  }

  function hslToRgb(h: number, s: number, l: number): { r: number, g: number, b: number } {
    s /= 100;
    l /= 100;
    const k = (n: number) => (n + h / 30) % 12;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
    return {
      r: Math.round(255 * f(0)),
      g: Math.round(255 * f(8)),
      b: Math.round(255 * f(4))
    };
  }

  // Load Recents
  function loadRecents() {
    try {
      const data = localStorage.getItem("instadl-recent-colors");
      recents = data ? JSON.parse(data) : [];
      updateRecentsUI();
    } catch (e) {
      recents = [];
    }
  }

  function saveRecent(color: string) {
    // Avoid duplicates of preset colors in recents
    const presets = ["#ffffff", "#000000", "#f4f4f5", "#3f3f46", "#f2efe9", "#faf5e6", "#ffebf0", "#dbeafe"];
    if (presets.includes(color.toLowerCase())) return;

    recents = recents.filter(c => c.toLowerCase() !== color.toLowerCase());
    recents.unshift(color);
    if (recents.length > 8) recents.pop();

    try {
      localStorage.setItem("instadl-recent-colors", JSON.stringify(recents));
      updateRecentsUI();
    } catch (e) {}
  }

  function updateRecentsUI() {
    if (!recentWrapper || !recentGroup) return;
    
    if (recents.length === 0) {
      recentWrapper.classList.add("hidden");
      return;
    }

    recentWrapper.classList.remove("hidden");
    recentGroup.innerHTML = "";

    recents.forEach(color => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.dataset.color = color;
      btn.title = color;
      btn.ariaLabel = `Recent color ${color}`;
      btn.className = "h-6 w-6 rounded-md border border-hairline-strong/20 hover:scale-110 active:scale-95 transition-all cursor-pointer shadow-sm relative group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary flex items-center justify-center";
      btn.style.backgroundColor = color;

      // Determine brightness via YIQ formula
      const rgb = hexToRgb(color);
      let isDarkColor = false;
      if (rgb) {
        const yiq = ((rgb.r * 299) + (rgb.g * 587) + (rgb.b * 114)) / 1000;
        isDarkColor = yiq < 128;
      }
      const checkColorClass = isDarkColor ? "text-white" : "text-black";

      if (color.toLowerCase() === activeColor.toLowerCase()) {
        btn.classList.add("active-preset");
      }

      const ringBadge = document.createElement("span");
      ringBadge.className = "absolute inset-0 rounded-md ring-2 ring-primary scale-0 group-[.active-preset]:scale-100 transition-transform";
      btn.appendChild(ringBadge);

      // Create check icon
      const checkSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      checkSvg.setAttribute("class", `h-3.5 w-3.5 ${checkColorClass} opacity-0 group-[.active-preset]:opacity-100 transition-opacity z-10`);
      checkSvg.setAttribute("fill", "none");
      checkSvg.setAttribute("viewBox", "0 0 24 24");
      checkSvg.setAttribute("stroke", "currentColor");
      checkSvg.setAttribute("stroke-width", "3.5");
      
      const checkPath = document.createElementNS("http://www.w3.org/2000/svg", "path");
      checkPath.setAttribute("stroke-linecap", "round");
      checkPath.setAttribute("stroke-linejoin", "round");
      checkPath.setAttribute("d", "m4.5 12.75 6 6 9-13.5");
      checkSvg.appendChild(checkPath);
      
      btn.appendChild(checkSvg);

      btn.addEventListener("click", () => {
        setColor(color, "recent");
      });

      recentGroup.appendChild(btn);
    });
  }

  // State Syncer
  function setColor(color: string, source: "picker" | "hex" | "rgb" | "hsl" | "preset" | "recent") {
    // Validate hex string
    let parsedHex = color;
    if (source === "hex") {
      if (!color.startsWith("#")) {
        color = "#" + color;
      }
      if (!/^#[0-9a-f]{3,8}$/i.test(color)) {
        return; // invalid hex
      }
      parsedHex = color;
    } else if (source === "rgb") {
      const parts = color.split(",").map(p => parseInt(p.trim(), 10));
      if (parts.length === 3 && parts.every(p => !isNaN(p) && p >= 0 && p <= 255)) {
        parsedHex = rgbToHex(parts[0], parts[1], parts[2]);
      } else {
        return; // invalid rgb
      }
    } else if (source === "hsl") {
      const parts = color.split(",").map(p => parseInt(p.trim(), 10));
      if (parts.length === 3 && !isNaN(parts[0]) && !isNaN(parts[1]) && !isNaN(parts[2])) {
        const rgb = hslToRgb(parts[0], parts[1], parts[2]);
        parsedHex = rgbToHex(rgb.r, rgb.g, rgb.b);
      } else {
        return; // invalid hsl
      }
    }

    activeColor = parsedHex;
    
    // Sync all inputs
    if (source !== "picker" && colorPickerInput) {
      colorPickerInput.value = parsedHex.substring(0, 7);
    }
    
    if (source !== "hex" && colorHexInput) {
      colorHexInput.value = parsedHex;
    }

    const rgb = hexToRgb(parsedHex);
    if (rgb) {
      if (source !== "rgb" && colorRgbInput) {
        colorRgbInput.value = `${rgb.r}, ${rgb.g}, ${rgb.b}`;
      }
      if (source !== "hsl" && colorHslInput) {
        const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
        colorHslInput.value = `${hsl.h}, ${hsl.s}, ${hsl.l}`;
      }
    }

    if (customColorVal) {
      customColorVal.textContent = parsedHex.toUpperCase();
    }

    // Update preset checkmark badges
    const allPresets = document.querySelectorAll("#custom-presets-group button");
    allPresets.forEach(btn => {
      const btnColor = btn.getAttribute("data-color");
      if (btnColor && btnColor.toLowerCase() === parsedHex.toLowerCase()) {
        btn.classList.add("active-preset");
      } else {
        btn.classList.remove("active-preset");
      }
    });

    // Update recents checkmark badges
    const allRecents = document.querySelectorAll("#recent-colors-group button");
    allRecents.forEach(btn => {
      const btnColor = btn.getAttribute("data-color");
      if (btnColor && btnColor.toLowerCase() === parsedHex.toLowerCase()) {
        btn.classList.add("active-preset");
      } else {
        btn.classList.remove("active-preset");
      }
    });

    // Save recent if it's from custom pickers
    if (source === "picker" || source === "hex" || source === "rgb" || source === "hsl") {
      saveRecent(parsedHex);
    }

    // Dispatch Event to Index
    document.dispatchEvent(new CustomEvent("custom-color-changed", {
      detail: { color: parsedHex }
    }));
  }

  // Event Listeners
  if (colorPickerInput) {
    colorPickerInput.addEventListener("input", (e) => {
      setColor((e.target as HTMLInputElement).value, "picker");
    });
  }

  if (colorHexInput) {
    colorHexInput.addEventListener("input", (e) => {
      setColor((e.target as HTMLInputElement).value, "hex");
    });
  }

  if (colorRgbInput) {
    colorRgbInput.addEventListener("input", (e) => {
      setColor((e.target as HTMLInputElement).value, "rgb");
    });
  }

  if (colorHslInput) {
    colorHslInput.addEventListener("input", (e) => {
      setColor((e.target as HTMLInputElement).value, "hsl");
    });
  }

  // Presets Handlers
  if (presetsGroup) {
    const presetButtons = presetsGroup.querySelectorAll("button");
    presetButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const color = btn.getAttribute("data-color");
        if (color) {
          setColor(color, "preset");
        }
      });
    });
  }

  // Init
  loadRecents();
  setColor(activeColor, "preset");
</script>
