        <button
          type="button"
          data-color="#dbeafe"
          title="Soft Blue"
          aria-label="Soft Blue Preset"
          class="h-6 w-6 rounded-md border border-hairline-strong/20 bg-[#dbeafe] hover:scale-110 active:scale-95 transition-all cursor-pointer shadow-sm relative group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary flex items-center justify-center"
        >
          <span class="absolute inset-0 rounded-md ring-2 ring-primary scale-0 group-[.active-preset]:scale-100 transition-transform"></span>
          <svg class="h-3.5 w-3.5 text-black opacity-0 group-[.active-preset]:opacity-100 transition-opacity z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
