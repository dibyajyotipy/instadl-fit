    <!-- Recent Colors -->
    <div id="recent-colors-wrapper" class="space-y-1.5 pt-1 hidden">
      <span class="text-[9px] text-mute font-bold uppercase tracking-wider block select-none">Recent Colors</span>
      <div class="flex flex-wrap gap-2.5" id="recent-colors-group">
        <!-- populated dynamically via JS -->
      </div>
