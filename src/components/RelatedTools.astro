---
interface Props {
  title?: string;
  limit?: number;
  id?: string;
}

const { title = "Related Photo Tools", limit = 3, id } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "");

const tools = [
  {
    path: "/no-crop-square-blur",
    title: "No Crop Square Blur",
    description: "Resize horizontal or vertical photos into a 1:1 square frame without cropping. Instantly add blurred backgrounds.",
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="12" cy="12" r="4" stroke-dasharray="2 2" />
    </svg>`
  },
  {
    path: "/fit-full-photo-instagram",
    title: "Instagram Full Photo Fit",
    description: "Fit your full photo on Instagram without cropping. Easily resize landscape and vertical photos to Instagram ratios.",
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75h16.5m-16.5 16.5h16.5M3.75 12h16.5" />
    </svg>`
  },
  {
    path: "/convert-landscape-to-portrait",
    title: "Landscape to Portrait",
    description: "Convert landscape photos to portrait online without cropping. Turn 16:9 images into 4:5 posts or 9:16 stories.",
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v18M3 9h18" />
    </svg>`
  },
  {
    path: "/instagram-3-4-grid-fix",
    title: "Profile Grid Crop Fixer",
    description: "Fix the Instagram profile grid crop. Prevent your vertical 4:5 posts from getting cut off in your 1:1 profile grid.",
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25V6Z" />
    </svg>`
  },
  {
    path: "/instagram-aspect-ratio-calculator",
    title: "Aspect Ratio Calculator",
    description: "Calculate Instagram aspect ratios instantly. Find dimensions for feed posts, reels, stories, and profile photos.",
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <rect x="4" y="3" width="16" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2" />
    </svg>`
  }
];

const normalize = (p: string) => p.replace(/\/$/, "");

const related = tools
  .filter((t) => normalize(t.path) !== normalize(currentPath))
  .slice(0, limit);
---

{related.length > 0 && (
  <section id={id} class="py-16 border-t border-hairline bg-canvas/30 relative overflow-hidden">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink mb-4">
          {title}
        </h2>
        <p class="text-sm text-body">
          Optimize your image ratios, sizes, and backgrounds with our suite of free browser-based tools.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
        {related.map((tool) => (
          <a
            href={tool.path}
            class="group glass-card glass-card-hover rounded-xl p-6 flex flex-col gap-4 shadow-level2 hover:shadow-level3 transition-all duration-300 block hover:no-underline"
          >
            <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-hairline bg-canvas-soft text-ink group-hover:border-ink group-hover:text-ink transition-colors">
              <span set:html={tool.icon} />
            </div>
            <div>
              <h3 class="text-sm font-semibold text-ink mb-2 group-hover:text-link transition-colors flex items-center gap-1.5">
                {tool.title}
                <svg class="h-3.5 w-3.5 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </h3>
              <p class="text-xs text-body leading-relaxed">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
