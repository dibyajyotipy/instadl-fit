        <a href="/convert-landscape-to-portrait" class="text-mute hover:text-ink transition-colors">Convert Landscape to Portrait</a>
        <a href="/no-crop-square-blur" class="text-mute hover:text-ink transition-colors">No Crop Square Blur Tool</a>
        <a href="/instagram-3-4-grid-fix" class="text-mute hover:text-ink transition-colors">Fix 3:4 Profile Grid Crop</a>
      </div>
    </div>

    <div class="md:col-span-3 flex flex-col gap-3 md:items-end">
      <span class="font-mono text-[10px] font-bold text-ink uppercase tracking-wider">Navigation</span>
      <div class="flex flex-col md:items-end gap-2 text-[10px] font-mono">
        <div class="flex items-center gap-1.5 text-mute">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          All Systems Operational
        </div>
        <a href="#features" class="text-mute hover:text-ink transition-colors">Features</a>
        <a href="#faq" class="text-mute hover:text-ink transition-colors">FAQ</a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-mute hover:text-ink transition-colors flex items-center gap-1">
          GitHub
          <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path></svg>
        </a>
      </div>
    </div>
