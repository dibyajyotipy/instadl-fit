---
---
<footer class="border-t border-hairline bg-canvas pt-12 pb-28 md:py-16 text-xs text-body relative z-10">
  <div class="mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Brand Info -->
    <div class="flex flex-col items-center md:items-start gap-2">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <circle cx="12" cy="10" r="3" />
          <path d="M21 15h-6l-3-3-3 3H3" />
        </svg>
        <span class="font-mono text-sm tracking-tight text-ink font-semibold">
          instadl<span class="text-[10px] bg-hairline-strong text-ink px-1.5 py-0.5 rounded-sm font-normal">fit</span>
        </span>
      </div>
      <p class="text-[10px] text-mute text-center md:text-left mt-1">
        © {new Date().getFullYear()} instadl.online. All rights reserved.
      </p>
    </div>

    <!-- Right Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-mono text-[10px]">
      <div class="flex items-center gap-1.5 text-mute">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        All Systems Operational
      </div>
      <a href="#features" class="hover:text-ink transition-colors">Features</a>
      <a href="#faq" class="hover:text-ink transition-colors">FAQ</a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors flex items-center gap-1">
        GitHub
        <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path></svg>
      </a>
    </div>
  </div>
</footer>

