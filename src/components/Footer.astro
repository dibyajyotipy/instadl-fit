<footer class="border-t border-hairline bg-canvas pt-12 pb-28 md:py-16 text-xs text-body relative z-10">
  <div class="mx-auto max-w-7xl px-6 grid grid-cols-1 md:grid-cols-12 gap-8">
    <div class="md:col-span-4 flex flex-col items-start gap-4">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <circle cx="12" cy="10" r="3" />
          <path d="M21 15h-6l-3-3-3 3H3" />
        </svg>
        <span class="font-mono text-sm tracking-tight text-ink font-semibold">
          instadl<span class="text-[10px] bg-hairline-strong text-ink px-1.5 py-0.5 rounded-sm font-normal">fit</span>
        </span>
      </div>
      <p class="text-[10px] text-mute leading-relaxed">
        Fit photos to social media sizes without cropping. 100% private, local browser processing.
      </p>
      <p class="text-[10px] text-mute mt-2">
        © {new Date().getFullYear()} instadl.online. All rights reserved.
      </p>
