---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
  title?: string;
  limit?: number;
}

const { currentSlug = "", title = "Related Guides & Articles", limit = 3 } = Astro.props;

const allPosts = await getCollection('blog');

// Sort by pubDate descending
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Filter out current post
const related = sortedPosts
  .filter((post) => post.slug !== currentSlug)
  .slice(0, limit);
---

{related.length > 0 && (
  <section class="py-16 border-t border-hairline bg-canvas/30 relative overflow-hidden w-full">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink mb-4">
          {title}
        </h2>
        <p class="text-sm text-body">
          Level up your social media presence with our expert guides on image optimization and ratios.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
        {related.map((post) => (
          <article class="blog-card group">
            <div class="card-inner">
              <div class="card-body">
                <span class="card-date">
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
                <h3 class="card-title">
                  <a href={`/blog/${post.slug}`} class="hover:underline hover:text-link">
                    {post.data.title}
                  </a>
                </h3>
                <p class="card-description">
                  {post.data.description}
                </p>
              </div>
              <div class="card-footer">
                <a href={`/blog/${post.slug}`} class="card-link hover:no-underline">
                  Read Article
                  <svg class="link-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .blog-card {
    height: 100%;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    background-color: var(--canvas-soft);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    box-shadow: var(--shadow-level1);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-inner:hover {
    border-color: var(--hairline-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-level3);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-date {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: var(--link);
  }

  .card-description {
    font-size: 0.8125rem;
    color: var(--body);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-link:hover {
    color: var(--link);
  }

  .link-arrow {
    width: 0.75rem;
    height: 0.75rem;
    stroke: currentColor;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-link:hover .link-arrow {
    transform: translateX(3px);
  }
</style>
