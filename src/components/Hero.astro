---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Free Instagram No Crop Tool",
  description = "Resize photos instantly to fit social aspect ratios without cropping. Add smart blur backgrounds or solid color borders completely locally in your browser. Privacy-first, 100% free, and frictionless."
} = Astro.props;
---
<section class="relative overflow-hidden pt-12 pb-6 hero-glow border-b border-hairline">
  <div class="mx-auto max-w-3xl px-6 text-center relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas-soft-2 text-xs font-mono text-ink mb-4">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
      No Uploads • No Login • 100% Browser-Based
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-ink mb-3 text-balance leading-none">
      {title}
    </h1>

    <p class="text-sm sm:text-base text-body max-w-xl mx-auto text-pretty">
      {description}
    </p>
  </div>

  <!-- Mesh Glow Backdrop -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-30">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[250px] rounded-full blur-[100px] bg-gradient-to-tr from-violet/20 via-cyan/10 to-highlight-pink/20"></div>
  </div>
</section>

